# ==============================================================================
# HomeSpace Admin Portal - Environment Variables Template
# ==============================================================================

# 1. Keycloak Authentication & Identity Provider (IAM)
VITE_KEYCLOAK_BASE_URL=http://localhost:9000
VITE_KEYCLOAK_REALM=homespace-platform
VITE_KEYCLOAK_CLIENT_ID=homespace-admin-id

# 2. HomeSpace API Gateway (Spring Cloud Gateway Hub)
VITE_GATEWAY_BASE_URL=http://localhost:8080

# 3. HomeSpace Location Microservice (Self-hosted Vietnam Administrative Units)
VITE_LOCATION_SERVICE_URL=http://localhost:9999
