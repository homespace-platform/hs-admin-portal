VITE_KEYCLOAK_BASE_URL=http://localhost:9000
VITE_KEYCLOAK_REALM=homespace-platform
VITE_KEYCLOAK_CLIENT_ID=homespace-admin-id

VITE_GATEWAY_BASE_URL=http://localhost:8080
VITE_WEB_APP_URL=http://localhost:3000
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

# Admin moderation-queue alerts (public, build-time: restart `npm run dev` after changing).
# ENABLED: literal true/false; missing => true; any other value => disabled.
# POLL_INTERVAL_MS: clamped 10000..300000. POPUP_COOLDOWN_MS: clamped 10000..3600000.
# Near-live polling of an aggregate count (<= poll delay), not server push.
VITE_ADMIN_QUEUE_ALERTS_ENABLED=true
VITE_ADMIN_QUEUE_POLL_INTERVAL_MS=30000
VITE_ADMIN_QUEUE_POPUP_COOLDOWN_MS=60000
